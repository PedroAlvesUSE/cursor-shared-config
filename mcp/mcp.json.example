{
  "mcpServers": {
    "mcp_server_mysql": {
      "command": "node",
      "args": [
        "/ABS/PATH/TO/mcp-server-mysql/dist/index.js"
      ],
      "env": {
        "MYSQL_HOST": "YOUR_MYSQL_HOST",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "YOUR_MYSQL_USER",
        "MYSQL_PASS": "YOUR_MYSQL_PASSWORD",
        "MYSQL_DB": "YOUR_DATABASE",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false",
        "MYSQL_SSL": "true",
        "MYSQL_SSL_CA": "/ABS/PATH/TO/ssl_certs/server-ca.pem",
        "MYSQL_SSL_CERT": "/ABS/PATH/TO/ssl_certs/client-cert.pem",
        "MYSQL_SSL_KEY": "/ABS/PATH/TO/ssl_certs/client-key.pem"
      }
    },
    "headroom": {
      "command": "headroom",
      "args": ["mcp", "serve"]
    },
    "openobserve": {
      "url": "https://YOUR_OPENOBSERVE_HOST/openobserve/api/default/mcp",
      "headers": {
        "Authorization": "Basic YOUR_BASE64_EMAIL_PASSWORD"
      }
    }
  }
}
